# 复制本文件为 .env 后填写本机值；.env 已被 .gitignore 排除，切勿提交。
# 优先级：进程环境变量 > .env > 代码内置默认值。

PGHOST=localhost
# 本项目原始环境使用非标准端口 2023；标准 PostgreSQL 安装请改为 5432
PGPORT=2023
# 本项目原始环境把 MIMIC-IV 装在 postgres 库；自建库通常叫 mimiciv
PGDATABASE=postgres
PGUSER=postgres

# 密码不要写在这里的示例中。请：
#   Windows PowerShell: $env:PGPASSWORD="****"; python scripts/01_extract_ards.py
#   Git Bash / Linux  : PGPASSWORD='****' python scripts/01_extract_ards.py
# 或者仅在本地 .env 中添加一行 PGPASSWORD=...（.env 不入库）。
# PGPASSWORD=

# 可选：自建库若改过 schema 名
# MIMIC_SCHEMA_HOSP=mimiciv_hosp
# MIMIC_SCHEMA_ICU=mimiciv_icu
# MIMIC_SCHEMA_DERIVED=mimiciv_derived
# MIMIC_SCHEMA_NOTE=mimiciv_note
